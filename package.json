{
  "name": "@peekabu/peekplayer",
  "version": "1.1.2",
  "type": "module",
  "description": "Professional HTML5 video player with HLS support, custom controls, and multi-quality streaming",
  "main": "dist/peekplayer.cjs",
  "module": "dist/peekplayer.esm.js",
  "types": "dist/peekplayer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/peekplayer.d.ts",
      "import": "./dist/peekplayer.esm.js",
      "require": "./dist/peekplayer.cjs",
      "default": "./dist/peekplayer.esm.js"
    },
    "./css": "./dist/peekplayer.css"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "serve": "http-server . -p 3001 -a 0.0.0.0",
    "test": "node scripts/smoke-test.mjs",
    "test:ui": "playwright test",
    "lint": "eslint src",
    "prepare": "npm run build"
  },
  "keywords": [
    "video-player",
    "hls",
    "streaming",
    "html5-video",
    "custom-controls",
    "video",
    "player",
    "media",
    "adaptive-streaming",
    "typescript"
  ],
  "author": "peekabu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peek-Abu/PeekPlayer"
  },
  "homepage": "https://github.com/Peek-Abu/PeekPlayer#readme",
  "bugs": {
    "url": "https://github.com/Peek-Abu/PeekPlayer/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "hls.js": ">=1.5.20",
    "http-server": "^14.1.1",
    "rollup": "^4.9.6"
  }
}
